# Скопировать в .env рядом с docker-compose.prod.yml и заполнить. .env в git не попадает.
# Случайные строки: openssl rand -hex 32

# Домен сайта без https://. Без своего домена — IP сервера через sslip.io, например 5-35-12-34.sslip.io
DOMAIN=

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Тестовые пользователи с паролем password123. На настоящем пилоте — false
SEED_DEMO=true
# Плашка сверху каждой страницы. На настоящем пилоте — пусто
STAND_LABEL=Тестовый стенд. Не вводите настоящие имена, телефоны и адреса — данные периодически удаляются.

# Телефон координатора в формате +7XXXXXXXXXX — показывается в «Забыли пароль?» и в подвале сайта
SUPPORT_PHONE=
