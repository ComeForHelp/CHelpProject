{
  "name": "idu-na-pomoshch-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "«Иду на помощь!» — клиентская часть MVP (Next.js + Mantine)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "api:types": "openapi-typescript ${API_DOCS_URL:-http://localhost:3001/api/docs-json} -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/modals": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.20.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.91.0",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
}
