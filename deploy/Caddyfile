# Caddy сам получает и продлевает HTTPS-сертификат Let's Encrypt для {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	# Фото чеков до 10 МБ + запас на служебные поля формы
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Тестовый стенд не должен попадать в поисковики
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}
}
