# Подключение к PostgreSQL
DATABASE_URL=postgresql://idu:idu_password@localhost:5432/idu_na_pomoshch?schema=public

PORT=3001
# Откуда разрешены запросы фронтенда (через запятую)
CORS_ORIGIN=http://localhost:3000

# Секреты JWT — в продакшене длинные случайные строки
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Часовой пояс пилота (Владивосток, UTC+10, без перехода на летнее время)
APP_UTC_OFFSET_HOURS=10
# На сколько дней вперёд cron создаёт заявки из регулярных правил
RECURRING_HORIZON_DAYS=3

# Папка для фото чеков и рецептов; максимальный размер файла (МБ)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Отключить cron (например, в e2e-тестах)
CRON_ENABLED=true

# Сколько прокси стоит перед сервером (за Nginx — 1), чтобы лимиты считались по IP клиента
TRUST_PROXY=0
# Ограничение частоты запросов (false — выключить, например для нагрузочных тестов)
THROTTLE_ENABLED=true
